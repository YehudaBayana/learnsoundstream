# Marks production: enables Secure cookies.
ENV=production

# Render injects PORT automatically; only set it yourself elsewhere.
# PORT=8080

# Neon: Dashboard > Connect > uncheck "Connection pooling" (direct URL, host has no "-pooler").
# The direct URL is required so migrations (advisory locks) and pgx prepared statements work.
DB_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Alternative to DB_URL (used only when DB_URL / DATABASE_URL is empty)
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_SSLMODE=require

# Comma-separated frontend origins allowed by CORS (no trailing slash)
ALLOWED_ORIGINS=https://your-app.vercel.app
